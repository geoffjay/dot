# Managed by dot (module: lsd, dot {{ dot_version }}).

classic: false

blocks:
  - permission
  - user
  - group
  - size
  - date
  - name

color:
  when: always
  theme: custom

date: date

icons:
  when: auto
  theme: fancy
  separator: " "

layout: grid

size: default

sorting:
  column: name
  reverse: false
  dir-grouping: none

hyperlink: never
symlink-arrow: ⇒